worker_processes auto;
events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 64m;

    # WordPress behind Railway / reverse proxy: pass correct HTTPS to PHP.
    map $http_x_forwarded_proto $fcgi_https {
        default off;
        https   on;
    }

    server {
        # __NGINX_HTTP_PORT__ = Railway $PORT. Also :80 if the mesh hits that port.
        listen __NGINX_HTTP_PORT__ default_server;
        listen 80 default_server;
        server_name _;
        root /var/www/html;
        index index.php index.html;

        add_header X-App-Backend wp-nginx always;

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location / {
            try_files $uri $uri/ /index.php?$args;
        }

        location ~ \.php$ {
            include        fastcgi_params;
            fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param  HTTPS $fcgi_https;
            fastcgi_param  HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
            fastcgi_param  HTTP_X_FORWARDED_HOST  $http_x_forwarded_host;
            fastcgi_pass   127.0.0.1:9000;
            fastcgi_read_timeout 300;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
        }

        location ~* \.(htaccess|htpasswd|ini|log|conf)$ {
            deny all;
        }

        location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp)$ {
            expires 7d;
            access_log off;
        }
    }
}
